MONGO_URI=
JWT_SECRET=
# One-time owner creation only. Remove both values after running npm run admin:bootstrap.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_TOKEN_SECRET=

# Admin transactional email. Use console locally or resend for delivery.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="WellCare Security <onboarding@resend.dev>"
ADMIN_SESSION_DURATION_MS=43200000
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CLIENT_URL=http://localhost:8080
PORT=5000

# Dedicated server-side keys. Restrict each key to its named API and backend IPs.
GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_PLACES_SERVER_API_KEY=

# Phase 3C pricing defaults (INR). Override without changing application code.
SCOOTER_BASE_FARE=50
SCOOTER_PER_KM_RATE=12
CAB_BASE_FARE=150
CAB_PER_KM_RATE=20
ROUTE_FARE_CACHE_TTL_MS=300000

# Real-time guide tracking. Redis is optional for a single local server but required when scaling.
REDIS_URL=
SOCKET_ALLOWED_ORIGINS=http://localhost:8080
SOCKET_REDIS_STREAM=wellcare:socket.io
SOCKET_REDIS_STREAM_MAXLEN=10000
TRACKING_LOCATION_TTL_SECONDS=45
TRACKING_MIN_INTERVAL_MS=1500
TRACKING_HEARTBEAT_MS=10000
TRACKING_MONGO_CHECKPOINT_MS=30000
TRACKING_GUIDE_RECHECK_MS=30000
TRACKING_MAX_ACCURACY_METERS=500
TRACKING_MAX_SPEED_MPS=75