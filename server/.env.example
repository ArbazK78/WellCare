MONGO_URI=
JWT_SECRET=
# One-time owner creation only. Remove both values after running npm run admin:bootstrap.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_TOKEN_SECRET=

# Admin transactional email. Use console locally or resend for delivery.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="WellCare Security <onboarding@resend.dev>"
ADMIN_SESSION_DURATION_MS=43200000
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CLIENT_URL=http://localhost:8080
PORT=5000

# Dedicated server-side key restricted to the Google Routes API and server IPs.
GOOGLE_MAPS_SERVER_API_KEY=

# Phase 3C pricing defaults (INR). Override without changing application code.
SCOOTER_BASE_FARE=50
SCOOTER_PER_KM_RATE=12
CAB_BASE_FARE=150
CAB_PER_KM_RATE=20
ROUTE_FARE_CACHE_TTL_MS=300000
